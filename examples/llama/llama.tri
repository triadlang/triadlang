
import triad.tensor as T;
import triad.nn as nn;
import triad.ntri as np;

print("╔══════════════════════════════════════════════════════════════╗");
print("║                 llama.tri — LLaMA em triadlang                ║");
print("║  P1 (onda) + P2 (memória KV) + P3 (reservatório FDT)        ║");
print("║  Auto-calibração: sem métrica externa, o sistema se calibra.  ║");
