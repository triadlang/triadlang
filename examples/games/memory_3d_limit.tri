import triad.engine3d as e3;
import triad.ntri as np;

print("Memory3D — pushing toward the limit");
print("====================================");

for side in [3, 4, 5, 6] {
    let mem = e3.Memory3D(side=side, seed=3);
    let dim = side * side;
    let padrao = np.sign(np.random.default_rng(7).standard_normal(dim));
    mem.store(padrao);

    for t in range(4) {
        mem.eng.step(0.3);
    }

    let lido = mem.read();
    let acertos = 0;
    for j in range(dim) {
        if lido[j] == padrao[j] { acertos = acertos + 1; }
    }
    print(f"side={side}  bits={dim}  faithful={acertos}/{dim}  depth={mem.depth:.1f}");
}
