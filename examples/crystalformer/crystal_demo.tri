import triad;
import triad.nn as nn;
import triad.tensor as T;
import triad.net as net;
import triad.train as train;
import triad.ntri as np;

print("+==============================================================+");
print("|                                                            |");
print("|    +==================================================+     |");
print("|    |     CrystalFormer -- Triad-Native LLM             |     |");
print("|    |     End-to-End Demonstration                     |     |");
print("|    +==================================================+     |");
print("|                                                            |");
print("|  Architecture: Field Dynamics replaces Attention            |");
print("|  Triad:     iℏ ∂_t Ψ = [T + V + Λ|Ψ|² + V_mem]Ψ + η    |");
print("|  Substrates:   P1(wave) + P2(memory) + P3(reservoir)       |");
print("|  Complexity:   O(L·log L) via FFT spectral methods         |");
print("|  Sparsity:     Self-crystallization during training        |");
print("|                                                            |");
print("+==============================================================+");
print("");

print("=== PART 1: Architecture Overview ===");
print("");

print("Traditional Transformer:");
print("  Token -> Embed -> QKV Attention(O(L²·d)) -> FFN -> Output");
print("  Position: Learned or RoPE");
print("  Memory: KV cache per layer O(L·d)");
print("  Gradient: Through softmax(Q·K^T/√d)");
print("");

print("CrystalFormer:");
print("  Token -> Embed -> Project to Complex Field");
print("         -> Multi-scale Exp Conv (O(L·log L))");
print("         -> Triad Hamiltonian Evolution (FFT step)");
print("         -> Attractor Bank Recall (content-addressable)");
print("         -> Project to Real -> FFN -> Output");
print("  Position: Implicit in causal exp kernel");
print("  Memory: Crystal lattice O(n_sites) + attractor bank O(n_attract)");
print("  Gradient: Through field dynamics and attractor recall");
print("  Training: TriadFlow with physics constraints");
print("  Sparsity: Native crystallization (not post-hoc pruning)");
print("");

print("=== PART 2: Field Triad Demonstration ===");
print("");

print("The Triad Triad governs all computation:");
print("  iℏ ∂_t Ψ = [-(ℏ²/2m)∇² + V_ext + Λ|Ψ|² + V_mem + α(-Δ)^(σ/2) - iΓ]Ψ + η");
print("");

print("Running a quick field solve...");
let params = triad.regime("B0", N=64, D=1);
let result = triad.solve(params, T=5.0);

let crystal = triad.crystal(result);
let kstar = triad.k_star(result);
let peak = triad.peak(result);
let norm_val = triad.norm(result);

print("  Crystallinity:  " + str(crystal));
print("  k_star:         " + str(kstar));
print("  Peak density:   " + str(peak));
print("  Norm:           " + str(norm_val));
print("");

print("Chaos -> Crystallization phases:");
print("  1. Initial chaos (high noise, exploration)");
print("  2. Pattern formation (interference, self-organization)");
print("  3. Crystallization (stable attractors, frozen structure)");
print("");

print("=== PART 3: Multi-Scale Exponential Memory ===");
print("");

print("CausalExpConv replaces Q·K^T attention:");
print("");
print("  Attention:  A[i,j] = softmax(Q[i]·K[j]/√d)   -- O(L²) pairwise");
print("  Memory:     y[l] = Σ_{k≤l} K[l-k]·ρ[k]        -- O(L·log L) via FFT");
print("");
print("  Where K[t] = (1-α)·α^t is the exponential kernel.");
print("  Multiple heads at log-spaced decay rates:");
print("    α = exp(-ν·dt)  with ν ∈ {0.01, 0.1, 1.0, 10.0} Hz");
print("");

print("Demonstration: tracking density with exponential memory");
let demo_L = 32;
let demo_alpha = 0.9;

let signal = np.zeros(demo_L);
for i in range(8, 16) {
    signal[i] = 1.0;
}

let memory = np.zeros(demo_L);
let y = 0.0;
for i in range(demo_L) {
    y = demo_alpha * y + (1.0 - demo_alpha) * signal[i];
    memory[i] = y;
}

print("  Signal:    " + str(signal[0:16]) + "...");
print("  Memory(α=0.9): " + str(memory[0:16]) + "...");
print("  Note: memory persists well beyond the pulse -- retains context.");
print("");

print("=== PART 4: CrystalLM Small-Scale Training ===");
print("");

let TEXT = "the field oscillates and remembers. "
         + "the field couples and crystallizes. "
         + "memory persists through  dynamics. "
         + "the triad Triad governs all three substrates. "
         + "wavefunction psi evolves under the hamiltonian. "
         + "at the threshold of chaos computation is maximal. "
         + "crystallization emerges from self organization. "
         + "attractor basins store long term patterns. ";

print("Corpus: " + str(len(TEXT)) + " characters");
print("");

let tok = nn.CharTokenizer(TEXT);
let all_ids = tok.encode(TEXT);
let VOCAB = tok.vocab_size;
print("Vocabulary size: " + str(VOCAB));

let big_ids = [];
for i in range(30) {
    for id in all_ids {
        big_ids.push(id);
    }
}
print("Training tokens: " + str(len(big_ids)));

let SEQ = 32;
let dataset = nn.TextDataset(big_ids, SEQ);

print("");
print("Building CrystalLM (mini configuration)...");
print("  d_model=32, d_psi=16, n_blocks=2, n_heads=4");

print("Using net.TriadLM with crystal-style training...");
let model = net.TriadLM(
    VOCAB,
    32,
    2,
    4,
    2,
    Lambda=-0.5,
    nu_min=0.01,
    nu_max=10.0,
    gamma_0=0.01,
    T_bath=0.05,
    seed=42
);

let n_params = len(model.parameters());
print("Parameters: " + str(n_params));
print("");

print("Optimizer: TriadFlow (field-based, self-crystallizing)");
let opt = nn.TriadFlow(model.parameters(), lr=0.01, regime="B0",
                        seed=3, freeze=true);

let STEPS = 60;
let BATCH = 4;
let T_decay = 0.98;

print("");
print("Training " + str(STEPS) + " steps...");
print("");

let loss_history = [];
let crystal_history = [];

for step in range(STEPS) {
    let sample = dataset.batch(BATCH);
    let x = T.tensor(sample[0]);
    let y = T.tensor(sample[1]);

    let out = model(x);
    let logits = out[0];
    let loss = T.cross_entropy(logits, y);

    opt.zero_grad();
    loss.backward();
    opt.step();

    let lv = float(loss);
    let cf = opt.crystal_fraction();
    loss_history.push(lv);
    crystal_history.push(cf);

    if step % 15 == 0 or step == STEPS - 1 {
        print("  step " + str(step) + "/" + str(STEPS)
              + "  loss=" + str(lv)
              + "  crystal=" + str(cf));
    }
}

print("");
print("Training complete.");
print("  Initial loss:  " + str(loss_history[0]));
print("  Final loss:    " + str(loss_history[len(loss_history) - 1]));
print("  Final crystal: " + str(crystal_history[len(crystal_history) - 1]));
print("");

print("=== PART 5: Generation ===");
print("");

print("Generating with trained CrystalFormer...");
print("");

let generate_fn = fn(prompt_text, max_new, temp) {
    let prompt_ids = tok.encode(prompt_text);
    let gen = [];
    for id in prompt_ids { gen.push(id); }

    let ctx_len = SEQ;

    for step in range(max_new) {
        let start = 0;
        if len(gen) > ctx_len {
            start = len(gen) - ctx_len;
        }
        let ctx = [];
        for i in range(start, len(gen)) {
            ctx.push(gen[i]);
        }
        let ctx_t = T.tensor(np.array(ctx).reshape(1, -1));

        let result;
        with T.no_grad() {
            result = model(ctx_t);
        }

        let logits_arr = result[0].data;
        let last = logits_arr[0][len(ctx) - 1];

        if temp > 0.0 {
            last = last / float(temp);
        }

        let exp_l = np.exp(last - np.max(last));
        let probs = exp_l / np.sum(exp_l);
        let cumsum = np.cumsum(probs);
        let r = float(np.random.default_rng(step).random());
        let next_tok = 0;
        for i in range(len(cumsum)) {
            if r < cumsum[i] {
                next_tok = i;
                break;
            }
        }
        gen.push(next_tok);
    }

    return tok.decode(gen);
};

let prompts = [
    "the field",
    "memory",
    "crystallization",
    "the triad"
];

for prompt in prompts {
    let result = generate_fn(prompt, 60, 0.8);
    print("  Prompt:   " + prompt);
    print("  Generated: " + result);
    print("");
}

print("=== PART 6: Comparison with Transformer Baseline ===");
print("");

print("Training TransformerLM on same data...");

let tx_model = net.TransformerLM(VOCAB, 32, 2, 4, 2);
let tx_opt = nn.Adam(tx_model.parameters(), 0.01);

let tx_losses = [];
for step in range(STEPS) {
    let sample = dataset.batch(BATCH);
    let x = T.tensor(sample[0]);
    let y = T.tensor(sample[1]);

    let logits = tx_model(x);
    let loss = T.cross_entropy(logits, y);

    tx_opt.zero_grad();
    loss.backward();
    tx_opt.step();

    tx_losses.push(float(loss));

    if step % 15 == 0 or step == STEPS - 1 {
        print("  step " + str(step) + "/" + str(STEPS)
              + "  loss=" + str(float(loss)));
    }
}

print("");
print("Comparison Summary:");
print("  CrystalFormer initial: " + str(loss_history[0]));
print("  Transformer   initial: " + str(tx_losses[0]));
print("  CrystalFormer final:   " + str(loss_history[len(loss_history) - 1]));
print("  Transformer   final:   " + str(tx_losses[len(tx_losses) - 1]));
print("  CrystalFormer crystal: " + str(crystal_history[len(crystal_history) - 1]));
print("");

print("=== PART 7: Physics-Informed Training Analysis ===");
print("");

print("CrystalFormer adds physics constraints to the loss:");
print("");
print("  L_total = L_CE + λ_phys·L_phys + λ_cons·L_cons + λ_crystal·L_crystal");
print("");
print("  where:");
print("    L_CE     = cross-entropy (standard LM loss)");
print("    L_phys   = field residual |Hψ - Eψ|²");
print("    L_cons   = norm conservation |⟨ψ|ψ⟩ - 1|²");
print("    L_crystal = bonus for productive crystallinity range");
print("");
print("  λ_phys   = 0.01   (weak physics coupling)");
print("  λ_cons   = 0.001  (weak conservation)");
print("  λ_crystal = 0.0001 (small structure bonus)");
print("");

print("=== PART 8: Self-Calibration Protocol ===");
print("");

print("The system monitors field observables and adjusts:");
print("");
print("  Observables monitored:");
print("    • IPR (Inverse Participation Ratio) -- localization measure");
print("    • Crystallinity -- fraction of stabilized field modes");
print("    • k_star -- dominant wavenumber (structure scale)");
print("    • Peak density -- maximum field amplitude");
print("    • Norm -- total field intensity (should conserve)");
print("");
print("  Adjustments:");
print("    • IPR too low  -> increase |Λ| (stronger self-focusing)");
print("    • IPR too high -> decrease |Λ| (weaker ity)");
print("    • Crystal too high -> raise temperature (more exploration)");
print("    • Crystal too low  -> lower temperature (more crystallization)");
print("    • k_star too small -> increase σ (fractional derivative order)");
print("");

