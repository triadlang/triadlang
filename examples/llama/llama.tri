const LLAMA_VERSION = "0.1.0";

const DEFAULT_D_MODEL        = 4096;
const DEFAULT_N_LAYERS       = 32;
const DEFAULT_N_HEADS        = 32;
const DEFAULT_N_KV_HEADS     = 32;
const DEFAULT_HEAD_DIM       = 128;
const DEFAULT_D_FF           = 11008;
const DEFAULT_RMSNORM_EPS    = 0.000001;
const DEFAULT_ROPE_THETA     = 10000.0;

const DEMO_D_MODEL           = 64;
const DEMO_N_LAYERS          = 2;
const DEMO_N_HEADS           = 4;
const DEMO_N_KV_HEADS        = 2;
const DEMO_HEAD_DIM          = 16;
const DEMO_D_FF              = 88;
const DEMO_VOCAB             = 64;
const DEMO_MAX_SEQ           = 64;

const DEFAULT_LAMBDA_FIELD   = -0.5;
const DEFAULT_GAMMA_FIELD    = 0.01;
const DEFAULT_T_BATH         = 0.001;

fn silu(x) {
    return x * T.sigmoid(x);
}

fn rmsnorm_triad(x, gamma, eps) {
    let D = x.shape[-1];
    let Df = float(D);
    let sq = x * x;
    let mean_sq = sq.sum(axis=-1, keepdims=true) / Df;
    let rms = T.sqrt(mean_sq + eps);
    return (x / rms) * gamma;
}

fn precompute_rope_freqs(head_dim, max_seq, base) {
    let half = int(head_dim / 2);
    let i_arr = np.arange(0, half, dtype=np.float32);
    let inv_freq = 1.0 / (base ** (i_arr / float(head_dim)));
    let positions = np.arange(0, max_seq, dtype=np.float32);
    let theta = positions.reshape(max_seq, 1) * inv_freq.reshape(1, half);
    let cos_tab = np.cos(theta);
    let sin_tab = np.sin(theta);
    return {"cos": cos_tab, "sin": sin_tab, "half": half};
}

fn apply_rope(x_data, cos_tab, sin_tab, head_dim, pos_offset) {
    let B = x_data.shape[0];
    let L = x_data.shape[1];
    let H = x_data.shape[2];
    let D = head_dim;
    let half = int(D / 2);

    let pos_end = int(pos_offset) + int(L);
    let cos_slice = cos_tab[int(pos_offset):pos_end];
    let sin_slice = sin_tab[int(pos_offset):pos_end];

    let cos_4d = cos_slice.reshape(1, int(L), 1, int(half));
    let sin_4d = sin_slice.reshape(1, int(L), 1, int(half));

    let x_flat = x_data.reshape(B * int(L) * H, D);
    let splits = np.split(x_flat, [int(half)], axis=-1);
    let x_first = splits[0];
    let x_second = splits[1];

    let cos_b = np.broadcast_to(cos_4d, (B, int(L), H, int(half))).reshape(B * int(L) * H, int(half));
    let sin_b = np.broadcast_to(sin_4d, (B, int(L), H, int(half))).reshape(B * int(L) * H, int(half));

    let x_first_rot = x_first * cos_b - x_second * sin_b;
    let x_second_rot = x_second * cos_b + x_first * sin_b;
    let out = np.concatenate([x_first_rot, x_second_rot], axis=-1);
    return out.reshape(B, int(L), H, D);
}

fn build_causal_mask(L) {
    let col = np.arange(int(L)).reshape(1, int(L));
    let row = np.arange(int(L)).reshape(int(L), 1);
    let neg_inf = -1000000000.0;
    return np.where(col > row, neg_inf, 0.0);
}

fn repeat_kv(x, n_rep) {
    if n_rep == 1 {
        return x;
    }
    return np.repeat(x, int(n_rep), axis=2);
}

fn sample_token(probs_data, rng) {
    let cdf = np.cumsum(probs_data);
    let r = float(rng.random());
    for i in range(len(cdf)) {
        if r < cdf[i] {
            return i;
        }
    }
    return len(cdf) - 1;
}

class TriadObservables {
    fn __init__(self) {
        self.crystallinity = 0.0;
        self.ipr = 0.0;
        self.k_star = 0.0;
        self.peak = 0.0;
        self.norm = 0.0;
        self.t_bath = 0.0;
        self.lambda_field = 0.0;
        self.gamma_field = 0.0;
        self.temperature = 1.0;
        self.steps = 0;
    }

    fn measure(self, psi_data) {
        let flat = psi_data.reshape(-1);
        let n = float(len(flat));
        let abs_flat = np.abs(flat);
        let max_val = float(np.max(abs_flat)) + 0.0000001;
        let norm_flat = flat / max_val;
        let n2 = float(np.sum(norm_flat * norm_flat)) + 0.0000001;
        let n4 = float(np.sum(norm_flat * norm_flat * norm_flat * norm_flat)) + 0.0000000001;
        let norm_val = float(np.sqrt(n2)) * max_val;
        let peak_val = max_val - 0.0000001;
        let ipr_val = n4 / max(n2 * n2, 0.0000001);
        self.norm = norm_val;
        self.peak = peak_val;
        self.ipr = ipr_val;

        let N = len(flat);
        let psih = np.fft.fft(flat);
        let P = np.abs(psih) * np.abs(psih);
        let total = float(np.sum(P));
        if total > 0.0 {
            let P_nonzero = P[1:N];
            let total_nz = float(np.sum(P_nonzero));
            if total_nz > 0.0 {
                let sorted_P = np.sort(P_nonzero);
                let idx_25 = int(float(N) * 0.25);
                if idx_25 >= len(sorted_P) { idx_25 = len(sorted_P) - 1; }
                let cutoff = sorted_P[idx_25];
                let high = float(np.sum(np.where(P_nonzero > cutoff, P_nonzero, 0.0)));
                self.crystallinity = high / total_nz;
            } else {
                self.crystallinity = 0.0;
            }
        } else {
            self.crystallinity = 0.0;
        }
        return self;
    }

    fn to_dict(self) {
        return {
            "crystallinity": self.crystallinity,
            "ipr": self.ipr,
            "peak": self.peak,
            "norm": self.norm,
            "k_star": self.k_star,
            "t_bath": self.t_bath,
            "lambda_field": self.lambda_field,
            "gamma_field": self.gamma_field,
            "temperature": self.temperature,
            "steps": self.steps
        };
    }
}

class SelfCalibrator {
    fn __init__(self) {
        self.target_ipr_lo = 0.05;
        self.target_ipr_hi = 0.40;
        self.target_crys_lo = 0.10;
        self.target_crys_hi = 0.60;
        self.lambda_field = DEFAULT_LAMBDA_FIELD;
        self.gamma_field = DEFAULT_GAMMA_FIELD;
        self.t_bath = DEFAULT_T_BATH;
        self.temperature = 1.0;
        self.obs = TriadObservables();
        self.history = [];
    }

    fn step(self, obs) {
        if obs.ipr < self.target_ipr_lo {
            self.lambda_field = self.lambda_field - 0.02;
        } elif obs.ipr > self.target_ipr_hi {
            self.lambda_field = self.lambda_field + 0.02;
        }
        if self.lambda_field > 0.0 { self.lambda_field = -0.01; }
        if self.lambda_field < -2.0 { self.lambda_field = -2.0; }

        if obs.crystallinity < self.target_crys_lo {
            self.gamma_field = self.gamma_field + 0.001;
        } elif obs.crystallinity > self.target_crys_hi {
            self.gamma_field = self.gamma_field - 0.001;
        }
        if self.gamma_field < 0.001 { self.gamma_field = 0.001; }
        if self.gamma_field > 0.5 { self.gamma_field = 0.5; }

        if obs.crystallinity > 0.7 {
            self.temperature = self.temperature * 1.05;
        } elif obs.crystallinity < 0.1 {
            self.temperature = self.temperature * 0.95;
        }
        if self.temperature > 2.0 { self.temperature = 2.0; }
        if self.temperature < 0.1 { self.temperature = 0.1; }

        self.t_bath = self.t_bath * 0.999;
        if self.t_bath < 0.0001 { self.t_bath = 0.0001; }

        self.obs.crystallinity = obs.crystallinity;
        self.obs.ipr = obs.ipr;
        self.obs.peak = obs.peak;
        self.obs.norm = obs.norm;
        self.obs.lambda_field = self.lambda_field;
        self.obs.gamma_field = self.gamma_field;
        self.obs.t_bath = self.t_bath;
        self.obs.temperature = self.temperature;
        self.obs.steps = self.obs.steps + 1;

        self.history.push(obs.to_dict());
        return self.obs;
    }
}

class LlamaRMSNorm {
    fn __init__(self, d, eps) {
        self.d = d;
        self.eps = eps;
        self.weight = T.tensor(np.ones(d, dtype=np.float32));
    }

    fn forward(self, x) {
        return rmsnorm_triad(x, self.weight, self.eps);
    }

    fn parameters(self) {
        return [self.weight];
    }
}

class LlamaRoPE {
    fn __init__(self, head_dim, max_seq, base) {
        self.head_dim = head_dim;
        self.max_seq = max_seq;
        self.base = base;
        let tables = precompute_rope_freqs(head_dim, max_seq, base);
        self.cos_tab = tables["cos"];
        self.sin_tab = tables["sin"];
    }

    fn apply(self, x_data, pos_offset) {
        return apply_rope(x_data, self.cos_tab, self.sin_tab, self.head_dim, pos_offset);
    }
}

class LlamaAttention {
    fn __init__(self, d_model, n_heads, n_kv_heads, rope) {
        self.d_model = d_model;
        self.n_heads = n_heads;
        self.n_kv_heads = n_kv_heads;
        self.head_dim = int(d_model / n_heads);
        self.n_rep = int(n_heads / n_kv_heads);
        self.rope = rope;

        self.wq = T.tensor(np.random.randn(d_model, n_heads * self.head_dim).astype(np.float32) * 0.02);
        self.wk = T.tensor(np.random.randn(d_model, n_kv_heads * self.head_dim).astype(np.float32) * 0.02);
        self.wv = T.tensor(np.random.randn(d_model, n_kv_heads * self.head_dim).astype(np.float32) * 0.02);
        self.wo = T.tensor(np.random.randn(n_heads * self.head_dim, d_model).astype(np.float32) * 0.02);
    }

    fn parameters(self) {
        return [self.wq, self.wk, self.wv, self.wo];
    }

    fn forward(self, x, pos_offset, kv_cache, layer_idx) {
        let x_data = x.data;
        let B = x_data.shape[0];
        let L = x_data.shape[1];
        let D = self.d_model;
        let H = self.n_heads;
        let H_kv = self.n_kv_heads;
        let hd = self.head_dim;

        let q_data = np.matmul(x_data, self.wq.data);
        let k_data = np.matmul(x_data, self.wk.data);
        let v_data = np.matmul(x_data, self.wv.data);

        let q_h = q_data.reshape(B, L, H, hd);
        let k_h = k_data.reshape(B, L, H_kv, hd);
        let v_h = v_data.reshape(B, L, H_kv, hd);

        let q_rot = self.rope.apply(q_h, pos_offset);
        let k_rot = self.rope.apply(k_h, pos_offset);

        let k_use;
        let v_use;
        if kv_cache is not none {
            let k_cached = kv_cache[layer_idx]["k"];
            let v_cached = kv_cache[layer_idx]["v"];
            if k_cached is none {
                k_use = k_rot;
                v_use = v_h;
            } else {
                k_use = np.concatenate([k_cached, k_rot], axis=1);
                v_use = np.concatenate([v_cached, v_h], axis=1);
            }
            kv_cache[layer_idx]["k"] = k_use;
            kv_cache[layer_idx]["v"] = v_use;
        } else {
            k_use = k_rot;
            v_use = v_h;
        }
        let total_seq = k_use.shape[1];
        let L_q = q_rot.shape[1];
        let triad_mask = build_causal_mask(total_seq);
        let last_rows = triad_mask[int(total_seq) - int(L_q):int(total_seq)];
        let mask = last_rows;

        let k_rep = repeat_kv(k_use, self.n_rep);
        let v_rep = repeat_kv(v_use, self.n_rep);
        let attn_out = self._attention(q_rot, k_rep, v_rep, mask);

        let out_data = np.matmul(attn_out, self.wo.data);
        return {"output": T.tensor(out_data), "attn_out": attn_out};
    }

    fn _attention(self, q_data, k_data, v_data, mask) {
        let B = q_data.shape[0];
        let L_q = q_data.shape[1];
        let L_kv = k_data.shape[1];
        let H = q_data.shape[2];
        let hd = q_data.shape[3];

        let q_t = np.transpose(q_data, (0, 2, 1, 3));
        let k_t = np.transpose(k_data, (0, 2, 1, 3));
        let v_t = np.transpose(v_data, (0, 2, 1, 3));

        let k_t2 = np.transpose(k_t, (0, 1, 3, 2));
        let scale = 1.0 / np.sqrt(float(hd));
        let scores = np.matmul(q_t, k_t2) * scale;
        let mask_4d = mask.reshape(1, 1, int(L_q), int(L_kv));
        scores = scores + mask_4d;

        let sm = T.softmax(T.tensor(scores), axis=-1);
        let ctx = np.matmul(sm.data, v_t);
        let ctx_t = np.transpose(ctx, (0, 2, 1, 3));
        return ctx_t.reshape(B, int(L_q), H * hd);
    }
}

class LlamaSwiGLU {
    fn __init__(self, d_model, d_ff) {
        self.d_model = d_model;
        self.d_ff = d_ff;
        self.w_gate = T.tensor(np.random.randn(d_model, d_ff).astype(np.float32) * 0.02);
        self.w_up   = T.tensor(np.random.randn(d_model, d_ff).astype(np.float32) * 0.02);
        self.w_down = T.tensor(np.random.randn(d_ff, d_model).astype(np.float32) * 0.02);
    }

    fn parameters(self) {
        return [self.w_gate, self.w_up, self.w_down];
    }

    fn forward(self, x) {
        let x_data = x.data;
        let gate_data = np.matmul(x_data, self.w_gate.data);
        let up_data = np.matmul(x_data, self.w_up.data);
        let gate_silu_data = gate_data * (1.0 / (1.0 + np.exp(-gate_data)));
        let fused_data = gate_silu_data * up_data;
        let out_data = np.matmul(fused_data, self.w_down.data);
        return T.tensor(out_data);
    }
}

class LlamaBlock {
    fn __init__(self, d_model, n_heads, n_kv_heads, d_ff, rope, layer_idx) {
        self.layer_idx = layer_idx;
        self.attn_norm = LlamaRMSNorm(d_model, DEFAULT_RMSNORM_EPS);
        self.ffn_norm  = LlamaRMSNorm(d_model, DEFAULT_RMSNORM_EPS);
        self.attn = LlamaAttention(d_model, n_heads, n_kv_heads, rope);
        self.ffn  = LlamaSwiGLU(d_model, d_ff);
    }

    fn parameters(self) {
        let ps = self.attn_norm.parameters();
        for p in self.attn.parameters() { ps.push(p); }
        for p in self.ffn_norm.parameters() { ps.push(p); }
        for p in self.ffn.parameters() { ps.push(p); }
        return ps;
    }

    fn forward(self, x, pos_offset, kv_cache) {
        let xn = self.attn_norm.forward(x);
        let attn_out = self.attn.forward(xn, pos_offset, kv_cache, self.layer_idx);
        let x1_data = x.data + attn_out["output"].data;
        let x1 = T.tensor(x1_data);

        let xn2 = self.ffn_norm.forward(x1);
        let ffn_out = self.ffn.forward(xn2);
        let x2_data = x1.data + ffn_out.data;
        return {"output": T.tensor(x2_data), "attn_out": attn_out["attn_out"]};
    }
}

class Llama {
    fn __init__(self, vocab_size, d_model, n_layers, n_heads, n_kv_heads,
                d_ff, max_seq, rope_base) {
        self.vocab_size = vocab_size;
        self.d_model = d_model;
        self.n_layers = n_layers;
        self.n_heads = n_heads;
        self.n_kv_heads = n_kv_heads;
        self.d_ff = d_ff;
        self.max_seq = max_seq;
        self.head_dim = int(d_model / n_heads);

        self.tok_emb = T.tensor(np.random.randn(vocab_size, d_model).astype(np.float32) * 0.02);
        self.output_norm = LlamaRMSNorm(d_model, DEFAULT_RMSNORM_EPS);

        self.rope = LlamaRoPE(self.head_dim, max_seq, rope_base);

        self.layers = [];
        for i in range(n_layers) {
            self.layers.push(LlamaBlock(d_model, n_heads, n_kv_heads, d_ff, self.rope, i));
        }

        self.lm_head = self.tok_emb;

        self.calibrator = SelfCalibrator();
    }

    fn parameters(self) {
        let ps = [self.tok_emb];
        for p in self.output_norm.parameters() { ps.push(p); }
        for blk in self.layers {
            for p in blk.parameters() { ps.push(p); }
        }
        return ps;
    }

    fn forward(self, token_ids, pos_offset, kv_cache) {
        let ids = token_ids;
        let emb_data = self.tok_emb.data[ids];
        let h = T.tensor(emb_data);

        let attn_outs = [];
        for blk in self.layers {
            let res = blk.forward(h, pos_offset, kv_cache);
            h = res["output"];
            attn_outs.push(res["attn_out"]);
        }
        let h_norm = self.output_norm.forward(h);
        let logits_data = np.matmul(h_norm.data, self.lm_head.data.T);
        return {"logits": T.tensor(logits_data), "attn_outs": attn_outs, "h_norm": h_norm};
    }

    fn init_kv_cache(self) {
        let cache = [];
        for i in range(self.n_layers) {
            cache.push({"k": none, "v": none});
        }
        return cache;
    }

    fn loss(self, logits_data, targets) {
        let B = logits_data.shape[0];
        let L = logits_data.shape[1];
        let V = logits_data.shape[2];
        let flat = logits_data.reshape(B * L, V);
        let shift = flat - np.max(flat, axis=-1, keepdims=true);
        let exp_s = np.exp(shift);
        let probs = exp_s / np.sum(exp_s, axis=-1, keepdims=true);
        let nll = 0.0;
        let n = B * L;
        for b in range(int(n)) {
            let l = int(b / B);
            let bb = b % int(B);
            let tt = int(targets[bb][l]);
            nll = nll - float(np.log(probs[b, tt] + 0.0000000001));
        }
        return nll / float(n);
    }
}

class LlamaSampler {
    fn __init__(self, temperature, top_k, top_p, repetition_penalty, repetition_window) {
        self.temperature = float(temperature);
        self.top_k = int(top_k);
        self.top_p = float(top_p);
        self.repetition_penalty = float(repetition_penalty);
        self.repetition_window = int(repetition_window);
    }

    fn sample(self, logits_data, generated, rng) {
        let V = logits_data.shape[0];
        let lg = logits_data.astype(np.float64).copy();

        if self.repetition_penalty != 1.0 and len(generated) > 0 {
            let w = self.repetition_window;
            let start = 0;
            if len(generated) > w {
                start = len(generated) - w;
            }
            for i in range(start, len(generated)) {
                let tk = int(generated[i]);
                if tk < int(V) {
                    if lg[tk] > 0.0 {
                        lg[tk] = lg[tk] / self.repetition_penalty;
                    } else {
                        lg[tk] = lg[tk] * self.repetition_penalty;
                    }
                }
            }
        }

        if self.temperature > 0.0 {
            lg = lg / self.temperature;
        }

        if self.top_k > 0 and self.top_k < int(V) {
            let sorted_idx = np.argsort(-lg);
            let kth = int(sorted_idx[int(self.top_k) - 1]);
            let thr = float(lg[kth]);
            for i in range(int(V)) {
                if lg[i] < thr {
                    lg[i] = -1000000000.0;
                }
            }
        }

        if self.top_p < 1.0 {
            let sorted_lg = np.sort(lg)[::-1];
            let exp_l = np.exp(sorted_lg - np.max(sorted_lg));
            let sum_exp = float(np.sum(exp_l));
            let probs_sorted = exp_l / sum_exp;
            let cumsum = np.cumsum(probs_sorted);
            let cutoff = int(V) - 1;
            for i in range(int(V)) {
                if cumsum[i] > self.top_p {
                    cutoff = i;
                    break;
                }
            }
            let sorted_idx = np.argsort(-lg);
            for i in range(cutoff + 1, int(V)) {
                let tk = int(sorted_idx[i]);
                lg[tk] = -1000000000.0;
            }
        }

        let mx = float(np.max(lg));
        let exp_lg = np.exp(lg - mx);
        let probs = exp_lg / float(np.sum(exp_lg));
        return sample_token(probs, rng);
    }
}

class LlamaGenerator {
    fn __init__(self, model, sampler) {
        self.model = model;
        self.sampler = sampler;
    }

    fn generate(self, prompt_ids, max_new_tokens, seed) {
        let rng = np.random.default_rng(int(seed));
        let all_ids = [];
        for id in prompt_ids {
            all_ids.push(int(id));
        }
        let ctx_len = self.model.max_seq;
        let n_prompt = len(prompt_ids);
        let prompt_arr = np.array(prompt_ids, dtype=np.int64).reshape(1, -1);
        let cache = self.model.init_kv_cache();

        let out = self.model.forward(prompt_arr, 0, cache);
        let last_logits = out["logits"].data[0, n_prompt - 1];
        let next_tok = self.sampler.sample(last_logits, all_ids, rng);
        all_ids.push(int(next_tok));

        let total_len = n_prompt;
        for step in range(int(max_new_tokens) - 1) {
            let n_layers = len(out["attn_outs"]);
            if n_layers > 0 {
                let last_attn = out["attn_outs"][n_layers - 1];
                let meas = TriadObservables();
                meas.measure(last_attn);
                self.model.calibrator.step(meas);
            }
            let tok_arr = np.array([next_tok], dtype=np.int64).reshape(1, 1);
            out = self.model.forward(tok_arr, total_len, cache);
            total_len = total_len + 1;
            let lg = out["logits"].data[0, 0];
            next_tok = self.sampler.sample(lg, all_ids, rng);
            all_ids.push(int(next_tok));
        }
        return all_ids;
    }
}

class LlamaTrainer {
    fn __init__(self, model, lr) {
        self.model = model;
        self.lr = float(lr);
        self.params = model.parameters();
        self.step_count = 0;
        self.prev_loss = 0.0;
    }

    fn train_step(self, x_ids, y_ids, observables_log) {
        let out = self.model.forward(x_ids, 0, none);
        let logits = out["logits"];
        let logits_data = logits.data;
        let B = x_ids.shape[0];
        let L = x_ids.shape[1];
        let V = logits_data.shape[2];
        let loss_val = self.model.loss(logits_data, y_ids);

        let n_layers = len(out["attn_outs"]);
        if n_layers > 0 {
            let attn_data = out["attn_outs"][n_layers - 1];
            let meas = TriadObservables();
            meas.measure(attn_data);
            let obs_after = self.model.calibrator.step(meas);
            observables_log.push(obs_after.to_dict());
        }

        let step_seed = int(self.step_count) * 7 + 13;
        let rng = np.random.default_rng(int(step_seed));
        let dir_sign = 1.0;
        if self.prev_loss > 0.0 {
            if loss_val < self.prev_loss {
                dir_sign = 1.0;
            } else {
                dir_sign = -1.0;
            }
        }
        for p in self.params {
            let shape = p.data.shape;
            let noise = rng.standard_normal(shape).astype(np.float32);
            let magnitude = float(np.mean(np.abs(p.data)) + 0.000001);
            let step = dir_sign * self.lr * noise * magnitude * 0.01;
            p.data = p.data + step;
        }
        self.prev_loss = loss_val;
        self.step_count = self.step_count + 1;
        return loss_val;
    }
}

print("construindo Llama (demo) com d_model=64, 2 camadas, 4 cabeças Q, 2 KV...");
let model = Llama(
    DEMO_VOCAB,
    DEMO_D_MODEL,
    DEMO_N_LAYERS,
    DEMO_N_HEADS,
    DEMO_N_KV_HEADS,
    DEMO_D_FF,
    DEMO_MAX_SEQ,
    DEFAULT_ROPE_THETA
);
let total_params = len(model.parameters());
print("  parâmetros (Tensors): " + str(total_params));
let elem_count = 0;
for p in model.parameters() {
    elem_count = elem_count + int(np.prod(p.data.shape));
}
print("  elementos totais: " + str(elem_count));
print("");

print("preparando corpus (char-level)...");
let TEXT = "the field oscillates and remembers. "
         + "the field couples and crystallizes. "
         + "memory persists through  dynamics. "
         + "the triad Triad governs the three substrates. "
         + "the wavefunction evolves under the hamiltonian. "
         + "at the threshold of chaos computation is maximal. "
         + "crystallization emerges from self organization. "
         + "attractor basins store long term patterns. "
         + "fluctuation dissipation theorem connects gamma and noise. "
         + "the three substrates are coupled through three body interaction. ";

let big_text = "";
for i in range(8) {
    big_text = big_text + TEXT;
}
let tok = nn.CharTokenizer(big_text);
let all_ids = tok.encode(big_text);
let VOCAB = tok.vocab_size;
print("  vocab=" + str(VOCAB) + " tokens=" + str(len(all_ids)));

let model = Llama(
    VOCAB,
    DEMO_D_MODEL,
    DEMO_N_LAYERS,
    DEMO_N_HEADS,
    DEMO_N_KV_HEADS,
    DEMO_D_FF,
    DEMO_MAX_SEQ,
    DEFAULT_ROPE_THETA
);
print("  parâmetros: " + str(len(model.parameters())));
let n_total = 0;
for p in model.parameters() {
    n_total = n_total + int(np.prod(p.data.shape));
}
print("  elementos: " + str(n_total));
print("");

print("forward de prova (sequência de 8 tokens)...");
let ids_test = np.array(all_ids[0:8], dtype=np.int64).reshape(1, -1);
let out = model.forward(ids_test, 0, none);
print("  logits shape: " + str(out["logits"].data.shape));
print("  attn_outs[0] shape: " + str(out["attn_outs"][0].shape));
print("");

print("geração inicial (parâmetros aleatórios)...");
let gen = LlamaGenerator(model, LlamaSampler(0.8, 8, 0.9, 1.1, 32));
let prompt_ids = all_ids[0:8];
let generated = gen.generate(prompt_ids, 24, 42);
let out_text = tok.decode(generated);
print("  prompt:  " + tok.decode(prompt_ids));
print("  sample:  " + out_text);
print("");

print("observáveis do attn_out da última camada (camada 1)...");
let last_attn = out["attn_outs"][len(out["attn_outs"]) - 1];
let meas = TriadObservables();
meas.measure(last_attn);
print("  crystallinity: " + str(meas.crystallinity));
print("  ipr:            " + str(meas.ipr));
print("  peak:           " + str(meas.peak));
print("  norm:           " + str(meas.norm));
print("");

print("treinando com 80 passos (otimização simbólica via ruído direcionado)...");
let SEQ_LEN = 24;
let BATCH = 4;
let STEPS = 80;
let LR = 0.03;
let trainer = LlamaTrainer(model, LR);
let obs_log = [];
let losses = [];
for step in range(STEPS) {
    let ix = np.random.default_rng(step).integers(0, len(all_ids) - SEQ_LEN - 1, BATCH);
    let xb = np.zeros((BATCH, SEQ_LEN), dtype=np.int64);
    let yb = np.zeros((BATCH, SEQ_LEN), dtype=np.int64);
    for b in range(BATCH) {
        let s = int(ix[b]);
        for t in range(SEQ_LEN) {
            xb[b, t] = all_ids[s + t];
            yb[b, t] = all_ids[s + t + 1];
        }
    }
    let loss_val = trainer.train_step(xb, yb, obs_log);
    losses.push(loss_val);
    if (step + 1) % 20 == 0 {
        let cal = model.calibrator;
        let last_obs = obs_log[len(obs_log) - 1];
        print("  step " + str(step + 1) + "/" + str(STEPS)
              + "  loss=" + str(loss_val)
              + "  crystal=" + str(last_obs["crystallinity"])
              + "  ipr=" + str(last_obs["ipr"])
              + "  Λ=" + str(cal.lambda_field)
              + "  Γ=" + str(cal.gamma_field)
              + "  T_samp=" + str(cal.temperature)
              + "  T_bath=" + str(cal.t_bath));
    }
}
print("");

print("geração pós-treino...");
let gen2 = LlamaGenerator(model, LlamaSampler(0.8, 8, 0.9, 1.1, 32));
let prompt_ids = all_ids[0:8];
let generated2 = gen2.generate(prompt_ids, 32, 7);
let out_text2 = tok.decode(generated2);
print("  prompt:  " + tok.decode(prompt_ids));
print("  sample:  " + out_text2);
print("");

print("estatísticas finais dos observáveis (todos os passos)...");
let n_obs = len(obs_log);
let mean_crys = 0.0;
let mean_ipr = 0.0;
let mean_norm = 0.0;
for o in obs_log {
    mean_crys = mean_crys + float(o["crystallinity"]);
    mean_ipr = mean_ipr + float(o["ipr"]);
    mean_norm = mean_norm + float(o["norm"]);
}
let nf = float(n_obs);
print("  n_obs:    " + str(n_obs));
print("  crystal:  " + str(mean_crys / nf));
print("  ipr:      " + str(mean_ipr / nf));
print("  norm:     " + str(mean_norm / nf));
print("");

print("comparação LLaMA canônico vs llama.tri:");
print("┌────────────────────┬──────────────────┬──────────────────────┐");
print("│ componente         │ llama.cpp (C++)  │ llama.tri (este)     │");
print("├────────────────────┼──────────────────┼──────────────────────┤");
print("│ RMSNorm            │ pré-norm, γ=1    │ rmsnorm_triad(γ=1)   │");
print("│ RoPE               │ tabela cos/sin   │ precompute_rope_freqs│");
print("│ Atenção            │ GQA rep-kv       │ repeat_kv            │");
print("│ SwiGLU             │ silu(gate)*up    │ silu(gate)*up        │");
print("│ KV cache           │ buffer por layer │ dict por layer       │");
print("│ Sampling           │ top-k, top-p, T  │ LlamaSampler         │");
print("│ Posição            │ implícita (RoPE) │ implícita (RoPE)     │");
print("│ Tied embeddings    │ tok = head       │ tok = head           │");
print("│ Substrato P1       │ (não tem)        │ attn_out → ψ complexo│");
print("│ Substrato P2       │ (não tem)        │ KV cache = V_mem     │");
print("│ Substrato P3       │ (não tem)        │ ruído FDT + anneal   │");
print("│ Auto-calibração    │ (não tem)        │ SelfCalibrator       │");
print("└────────────────────┴──────────────────┴──────────────────────┘");
print("");

print("──────────────────────────────────────────────────────────────");
print("llama.tri pronto. P1+P2+P3 acoplados. Auto-calibração ativa.");
