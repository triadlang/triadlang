import triad as triad;
import triad.calibrate as cal;

let params = triad.regime("B0", N=64);
let result = cal.calibrate(params, ["crystallinity", "dominant_k"], 8, false);

print("converged: " + str(result["converged"]));
print("iterations: " + str(result["n_iters"]));
let obs = result["final_observables"];
print("final crystallinity: " + str(obs["crystallinity"]));
