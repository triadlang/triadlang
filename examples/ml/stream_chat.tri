import triad.inference as inf;

let model = inf.load_model("Qwen/Qwen3-0.6B");

let ids = model.tokenizer.apply_chat_template([
    {"role": "user", "content": "Write a short poem about code."}
], add_generation_prompt=true, think=true);

print("streaming answer:");
print();

for tok in inf.stream_generate(model, ids, max_new_tokens=256, temperature=0.7) {
    if tok.phase == "answer" {
        print(tok.text);
    }
}
