import triad.nn as nn;
import triad.net as net;
import triad.tensor as tensor;

print("TriadLM with noise reduced to a low level (gamma_0=0, T_bath=0)");
print("=====================================================");

let VOCAB = 8;
let SEQ = 24;
let D = 32;
let LAYERS = 2;
let HEADS = 4;
let FFN = 2;
let STEPS = 200;
let LR = 0.05;

let xs_data = [];
let ys_data = [];
for b in range(8) {
    let row_x = [];
    let row_y = [];
    for t in range(SEQ) {
        row_x.push(t % 6);
        row_y.push((t + 1) % 6);
    }
    xs_data.push(row_x);
    ys_data.push(row_y);
}
let x = tensor.tensor(xs_data);
let y = tensor.tensor(ys_data);

let triad_lm = net.TriadLM(VOCAB, D, LAYERS, HEADS, FFN, gamma_0=0.001, T_bath=0.001);
let triad_params = triad_lm.parameters();
let triad_opt = nn.TriadFlow(triad_params, lr=LR, regime="anti_collapse", seed=3);

let first = 0.0;
let last = 0.0;
for step in range(STEPS) {
    let out = triad_lm(x);
    let loss = tensor.cross_entropy(out[0], y);
    triad_opt.zero_grad();
    loss.backward();
    triad_opt.step();
    let lv = float(loss);
    if step == 0 { first = lv; }
    if step == STEPS - 1 { last = lv; }
    if step % 40 == 0 {
        print("  step " + str(step) + " loss=" + str(lv) + " crystal=" + str(triad_opt.crystal_fraction()));
    }
}
print("triad-no-noise: " + str(first) + " -> " + str(last));
